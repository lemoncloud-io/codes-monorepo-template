{
  "name": "codes-monorepo-template",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r --filter './apps/*' dev",
    "build": "pnpm -r --filter './apps/*' build",
    "api:dev": "pnpm --filter backend dev",
    "api:deploy": "pnpm --filter backend deploy",
    "web:dev": "pnpm --filter frontend dev",
    "web:build": "pnpm --filter frontend build",
    "web:preview": "pnpm --filter frontend preview",
    "typecheck": "pnpm -r run --if-present typecheck"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=8"
  }
}
